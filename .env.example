# KAVACH Configuration

# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Supabase Credentials (Optional for local testing; SQLite/in-memory fallback is used if not provided)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Similarity Weights (Must sum to 1.0 / 100%)
WEIGHT_TEXT=0.70
WEIGHT_CATEGORY=0.20
WEIGHT_SUBCATEGORY=0.05
WEIGHT_NEIGHBORHOOD=0.05
